# Copy thành ".env.extension.local" rồi điền giá trị thật trước khi `npm run build:extension`.
# URL backend đang chạy (Render), extension chỉ xin quyền gọi đúng domain này
VITE_API_BASE_URL=https://your-api.onrender.com
VITE_SIGNALR_HUB_URL=https://your-api.onrender.com/hubs/events
# Trang web Meetly, dùng cho link chia sẻ
VITE_APP_URL=https://meetly-soon.vercel.app
