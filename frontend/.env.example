# Copy file này thành ".env" (cùng thư mục frontend/) rồi điền giá trị thật.
# Vite chỉ đọc file .env đặt trong thư mục frontend/ (nơi có vite.config.ts),
# KHÔNG đọc file .env.example ở gốc repo.

# URL gốc của Backend API (chạy `dotnet run` local -> xem backend/src/Meetly.API/Properties/launchSettings.json)
VITE_API_BASE_URL=http://localhost:5010

# URL của SignalR Hub bên Backend (backend CHƯA implement - giá trị này để sẵn cho sau)
VITE_SIGNALR_HUB_URL=http://localhost:5010/hubs/meeting
