# Copy file này thành ".env" (cùng thư mục frontend/) rồi điền giá trị thật.
# Vite chỉ đọc file .env đặt trong thư mục frontend/ (nơi có vite.config.ts),
# KHÔNG đọc file .env.example ở gốc repo.

# URL gốc của Backend API (chạy `dotnet run` local -> xem backend/src/Meetly.API/Properties/launchSettings.json)
VITE_API_BASE_URL=http://localhost:5010

# URL của SignalR Hub bên Backend (xem `EventHub` - map ở Program.cs: "/hubs/events")
VITE_SIGNALR_HUB_URL=http://localhost:5010/hubs/events

# Tuỳ chọn: Google Analytics 4, dạng G-XXXXXXXXXX (chỉ chạy trên bản build production)
# VITE_GA_MEASUREMENT_ID=

# Tuỳ chọn: Cloudflare Web Analytics, token lấy trong Cloudflare → Web Analytics (chỉ chạy trên bản build production)
# VITE_CF_ANALYTICS_TOKEN=
