# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=meetly_db
POSTGRES_PORT=5432
JWT_SECRET=replace-with-at-least-32-random-characters

# Backend
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=meetly_db;Username=postgres;Password=postgrespassword
JwtOptions__Issuer=Meetly
JwtOptions__Audience=Meetly.Web
JwtOptions__SecretKey=replace-with-at-least-32-random-characters
JwtOptions__ExpirationMinutes=1440
ALLOWED_ORIGINS=http://localhost:8080;http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080
ApplyMigrations=false

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:5000
VITE_SIGNALR_HUB_URL=http://localhost:5000/hubs/events
