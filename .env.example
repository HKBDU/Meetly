# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=meetly_db
POSTGRES_PORT=5432

# Backend Database Connection String
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=meetly_db;Username=postgres;Password=postgrespassword

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:5010
VITE_SIGNALR_HUB_URL=http://localhost:5010/hubs/events

# Backend app settings (ASP.NET đọc biến môi trường dạng Section__Key)
App__FrontendBaseUrl=http://localhost:5173
Cors__AllowedOrigins__0=http://localhost:5173
# Chỉ bật khi API chạy sau reverse proxy tin cậy (Render, Nginx...), để rate limit lấy đúng IP client
ForwardedHeaders__Enabled=false
